# Copy to .env. Never commit the actual .env or credentials.
# Default config.yaml uses a deterministic offline mock and needs no keys.
# LATTICE_CONFIG=configs/api.yaml

# Used by configs/api.yaml; replace with your provider's actual key.
# MODEL_API_KEY=your-api-key

# Optional if you replace vllm.yaml's api_key: EMPTY with api_key_env: VLLM_API_KEY.
# VLLM_API_KEY=your-local-server-key

# Native Anthropic support: pip install -e '.[anthropic]'
# Use provider: anthropic and api_key_env: ANTHROPIC_API_KEY in the model config.
# ANTHROPIC_API_KEY=your-api-key
